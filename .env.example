# Port the backend listens on
PORT=8787

# Administrator account created automatically on first start.
# Change the password before deploying; it is only used when no administrator exists yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password-now

# ID of the central Google Drive folder ("Route Collection") that has been
# shared with the service-account email. Copy it from the Drive URL:
# https://drive.google.com/drive/folders/<THIS_ID>
DRIVE_FOLDER_ID=

# How long a login token stays valid, in days
TOKEN_TTL_DAYS=30

# Public address of this server (used only for display in the admin interface)
SERVER_URL=http://localhost:8787

# Google authentication — preferred: OAuth refresh token (no service-account key needed).
# Create an OAuth client ID of type "Desktop app", then run: npm run authorize
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
